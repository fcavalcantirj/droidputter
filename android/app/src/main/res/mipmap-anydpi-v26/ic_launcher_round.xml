<?xml version="1.0" encoding="utf-8"?>
<!-- Felipe's rendered Cardputer (screen with a prompt, keys, USB-C module) as the foreground; the
     inset keeps the device inside the adaptive safe zone on circular masks. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground>
        <inset android:drawable="@drawable/ic_launcher_fg" android:inset="14%"/>
    </foreground>
</adaptive-icon>
