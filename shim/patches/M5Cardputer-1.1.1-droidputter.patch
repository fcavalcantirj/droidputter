@@ -51,10 +51,20 @@
     return ret;
 }
 
+#include <droidputter.h>
 void Keyboard_Class::updateKeyList()
 {
     if (_keyboard_reader) {
         _keyboard_reader->update();
+    }
+    dp::poll();
+    if (_keyboard_reader) {
+        uint8_t r[16], c[16]; uint8_t n = dp::injectedKeys(r, c, 16);
+        auto& kl = _keyboard_reader->mutableKeyList();
+        for (uint8_t i = 0; i < n; i++) {
+            bool dup = false; for (auto& k : kl) if (k.x == c[i] && k.y == r[i]) { dup = true; break; }
+            if (!dup) { Point2D_t p; p.x = c[i]; p.y = r[i]; kl.push_back(p); }
+        }
     }
 }
 
